[Unit]
Description=Keysmith input broker (evdev reader, hotkey matcher)
Documentation=file:///usr/share/doc/keysmith/README.md

[Service]
ExecStart=/usr/local/bin/ks-inputd
Restart=on-failure
RuntimeDirectory=keysmith
RuntimeDirectoryMode=0755
DevicePolicy=closed
DeviceAllow=char-input r
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
