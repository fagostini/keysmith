[Unit]
Description=Keysmith input broker (evdev reader, hotkey matcher)
Documentation=https://github.com/fagostini/keysmith

[Service]
ExecStart=/usr/bin/ks-inputd
Restart=on-failure
# Exit 2 = emergency exit (Backspace+Esc+Enter): stay stopped until restarted by hand.
RestartPreventExitStatus=2
RuntimeDirectory=keysmith
RuntimeDirectoryMode=0755
DevicePolicy=closed
DeviceAllow=char-input r
DeviceAllow=/dev/uinput rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
